# STX / USDCx. Copy to .env.stx (gitignored) and fill the wallet:
#   cp .env.stx.example .env.stx
#   npm run tick -- --pool stx
#
# STX is both the volatile inventory (base) and the gas token. The bot keeps
# STX_GAS_RESERVE_USTX undeployed so you can still pay fees and withdraw.

EXECUTION_MODE=dry_run
TICK_INTERVAL_MS=120000

POOL_ID=dlmm_14
POOL_STRATEGY=stx-usdcx-curve
BASE_TOKEN_CONTRACT=SM1793C4R5PZ4NS4VQ4WMP7SKKYVH8JZEWSZ9HCCR.token-stx-v-1-2
QUOTE_TOKEN_CONTRACT=SP120SBRBQJ00MCWS7TM5R8WJNTTKD5K0HFRC2CNE.usdcx

SIGNER_ADDRESS=
SIGNER_KEY=
STACKS_NODE_URL=

# Wider than sBTC: STX gaps harder. Decay 0.6 still peaks at the active bin.
CURVE_HALF_WIDTH_BINS=13
CURVE_MAX_HALF_WIDTH_BINS=18
CURVE_DECAY=0.6
CURVE_SIZE_FRACTION=0.35
CURVE_REPOSITION_DRIFT_BINS=13
CURVE_MAX_REPOSITION_DRIFT_BINS=20
SIGMA_REF=0.001

# Wider divergence band: this pool can lag the CoinGecko STX print by ~90 bps.
DIVERGENCE_WARN_BPS=150
DIVERGENCE_HALT_BPS=250
F_STAR=0.38
F_SOFT=0.52
F_HARD=0.67
DERISK_MAX_FRACTION=0.10
MAX_POSITION_USTX=2000000000

FEE_MEMPOOL_PERCENTILE=p25
MIN_TX_FEE_USTX=50000
MAX_TX_FEE_USTX=150000
DEFAULT_TX_FEE_USTX=50000

COINGECKO_REFERENCE_ID=blockstack

ENABLE_SWAP=true
SWAP_MAX_STEPS=8
METRICS_HTTP_PORT=8082
LOG_PRETTY=true
