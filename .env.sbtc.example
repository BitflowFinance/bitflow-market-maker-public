# sBTC / USDCx. Copy to .env.sbtc (gitignored) and fill the wallet:
#   cp .env.sbtc.example .env.sbtc
#   npm run tick -- --pool sbtc

EXECUTION_MODE=dry_run
TICK_INTERVAL_MS=120000

POOL_ID=dlmm_1
POOL_STRATEGY=sbtc-usdcx-curve
BASE_TOKEN_CONTRACT=SM3VDXK3WZZSA84XXFKAFAF15NNZX32CTSG82JFQ4.sbtc-token
QUOTE_TOKEN_CONTRACT=SP120SBRBQJ00MCWS7TM5R8WJNTTKD5K0HFRC2CNE.usdcx

SIGNER_ADDRESS=
SIGNER_KEY=
STACKS_NODE_URL=

# Geometric curve peaked at the active bin: weight = decay^|offset|.
# ±6 bins (~±1.3% at bin_step 10). Decay 0.6 keeps most depth on the active bin.
CURVE_HALF_WIDTH_BINS=6
CURVE_MAX_HALF_WIDTH_BINS=8
CURVE_DECAY=0.6
CURVE_SIZE_FRACTION=0.45
CURVE_REPOSITION_DRIFT_BINS=6
CURVE_MAX_REPOSITION_DRIFT_BINS=9

DIVERGENCE_WARN_BPS=80
DIVERGENCE_HALT_BPS=150
F_STAR=0.38
F_SOFT=0.52
F_HARD=0.67
DERISK_MAX_FRACTION=0.13

FEE_MEMPOOL_PERCENTILE=p25
MIN_TX_FEE_USTX=50000
MAX_TX_FEE_USTX=150000
DEFAULT_TX_FEE_USTX=50000

COINGECKO_REFERENCE_ID=bitcoin

ENABLE_SWAP=true
SWAP_MAX_STEPS=8
METRICS_HTTP_PORT=8081
LOG_PRETTY=true
