{
  "name": "bitflow-market-maker",
  "version": "0.1.0",
  "description": "Bitflow DLMM curve market maker for sBTC/USDCx and STX/USDCx.",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "tick": "tsx src/index.ts --once",
    "analyze": "tsx scripts/analyze-metrics.ts",
    "backtest": "tsx scripts/backtest-width.ts",
    "watch": "tsx scripts/pnl-watch.ts",
    "curve": "tsx scripts/curve-view.ts",
    "fees": "tsx scripts/fee-report.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@stacks/network": "^6.16.0",
    "@stacks/transactions": "^6.17.0",
    "dotenv": "^17.2.3",
    "pino": "^9.14.0",
    "stacks-tx-v7": "npm:@stacks/transactions@^7.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.22.4",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
